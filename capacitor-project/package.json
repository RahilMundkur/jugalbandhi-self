{
  "name": "jugalbandhi-self",
  "version": "3.0.0",
  "description": "Jugalbandhi Self — cross-platform reading app",
  "main": "index.js",
  "scripts": {
    "sync": "cap sync",
    "open:android": "cap open android",
    "open:ios": "cap open ios",
    "run:android": "cap run android",
    "run:ios": "cap run ios",
    "live:android": "cap run android --live-reload",
    "live:ios": "cap run ios --live-reload",
    "copy-www": "rm -rf www && mkdir -p www/audio && cp ../index.html www/ && cp ../manifest.json www/ && cp ../sw.js www/ && cp -r ../icons www/ && cp -r ../Cormorant_Garamond,Inter,Noto_Serif www/ && cp -r ../audio/en www/audio/"
  },
  "keywords": ["reading", "ebook", "tts"],
  "author": "Rahil Mundkur",
  "license": "UNLICENSED",
  "private": true,
  "dependencies": {
    "@capacitor/android": "^6.1.0",
    "@capacitor/app": "^6.0.1",
    "@capacitor/core": "^6.1.0",
    "@capacitor/ios": "^6.1.0",
    "@capacitor/preferences": "^6.0.2",
    "@capacitor/share": "^6.0.2",
    "@capacitor/splash-screen": "^6.0.2",
    "audio-pack-bridge": "file:./audio-pack-bridge"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.1.0",
    "typescript": "^5.4.0"
  }
}
