{
  "name": "jugalbandhi-self",
  "version": "3.0.0",
  "description": "Jugalbandhi Self — cross-platform reading app",
  "main": "index.js",
  "scripts": {
    "sync": "cap sync",
    "open:android": "cap open android",
    "open:ios": "cap open ios",
    "run:android": "cap run android",
    "run:ios": "cap run ios",
    "live:android": "cap run android --live-reload",
    "live:ios": "cap run ios --live-reload",
    "copy-www": "rm -rf www && mkdir -p www && cp ../index.html www/ && cp ../manifest.json www/ && cp ../sw.js www/ && cp -r ../icons www/ && cp -r ../Cormorant_Garamond,Inter,Noto_Serif www/",
    "verify": "node ../verify.js"
  },
  "keywords": [
    "reading",
    "ebook",
    "tts"
  ],
  "author": "Rahil Mundkur",
  "license": "UNLICENSED",
  "private": true,
  "dependencies": {
    "@capacitor/android": "^8.0.0",
    "@capacitor/app": "^8.0.0",
    "@capacitor/core": "^8.0.0",
    "@capacitor/filesystem": "^8.0.0",
    "@capacitor/ios": "^8.0.0",
    "@capacitor/preferences": "^8.0.0",
    "@capacitor/screen-orientation": "^8.0.0",
    "@capacitor/share": "^8.0.0",
    "@capacitor/splash-screen": "^8.0.0",
    "audio-pack-bridge": "file:./audio-pack-bridge",
    "crash-report-bridge": "file:./crash-report-bridge"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.0.0",
    "typescript": "^5.4.0"
  }
}